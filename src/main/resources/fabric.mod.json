{
  "schemaVersion": 1,
  "id": "multiactionkeybind",
  "version": "${version}",
  "name": "Multi-Action Keybind",
  "description": "A PojavLauncher-inspired multi-action touch keybind system for Minecraft Java Edition. Create unlimited custom buttons, each triggering up to 4 keyboard/mouse actions.",
  "authors": [
    "AncoreCloud"
  ],
  "contact": {
    "homepage": "https://ancorecloud.net",
    "sources": "https://github.com/ancorecloud/multiactionkeybind"
  },
  "license": "MIT",
  "icon": "assets/multiactionkeybind/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.ancorecloud.multiactionkeybind.MultiActionKeybindMod"
    ],
    "modmenu": [
      "net.ancorecloud.multiactionkeybind.gui.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
